# === AI provider ===
# Choose one provider. Set AI_PROVIDER to "openai" (default) or "anthropic".
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Only needed if AI_PROVIDER=anthropic (pip install -e '.[anthropic]')
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# === Email (SMTP) ===
# For Gmail use an App Password (not your account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=
# Optional: defaults to SMTP_USERNAME
EMAIL_FROM=

# === The Muse (optional job source; key only raises rate limits) ===
# Free key at https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# === Findwork (optional job source; requires a token) ===
# Free token at https://findwork.dev/developers/
FINDWORK_API_KEY=

# === SerpAPI / Google Jobs (optional; free tier ~100 searches/month) ===
# Key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# === Misc ===
LOG_LEVEL=INFO

# ============================================================
# Web app only (pip install -e '.[web]'). Not needed for the CLI.
# ============================================================
# Postgres in production; SQLite by default for local dev.
DATABASE_URL=sqlite:///data/app.db
# Session cookies + encryption of users' API keys. Use a long random value.
APP_SECRET_KEY=change-me-to-a-long-random-string
# Public URL of the app (used for the OAuth redirect).
BASE_URL=http://localhost:8000
# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BASE_URL>/auth/callback
# Leave blank locally to use the built-in dev login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In the web app, SMTP_* above is the shared sending mailbox for all users;
# each user's digest goes to their own address. Users bring their own AI key.
